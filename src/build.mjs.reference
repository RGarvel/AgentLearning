import fs from "node:fs";
import path from "node:path";
import { marked } from "marked";
import hljs from "highlight.js";

const COURSE = "C:\\dsh\\learning\\openai-agents-学习指南";
const SITE = "C:\\dsh\\learning\\course-site";
const OUT = path.join(SITE, "public");

const MODULES = [
  { id: "00", title: "导论", sub: "建立心智模型：Agent 到底是什么" },
  { id: "01", title: "核心运行时", sub: "对象、循环、产物、上下文" },
  { id: "02", title: "工具系统", sub: "让 Agent 有手有脚" },
  { id: "03", title: "多智能体编排", sub: "handoff、协作模式、沙箱" },
  { id: "04", title: "安全与护栏", sub: "护栏、审批、中断恢复" },
  { id: "05", title: "状态与记忆", sub: "会话与跨轮策略" },
  { id: "06", title: "模型与输出", sub: "Provider、结构化输出、流式" },
  { id: "07", title: "可观测性与质量", sub: "追踪、测试、排错" },
  { id: "08", title: "语音与实时", sub: "语音流水线、Realtime" },
  { id: "09", title: "源码剖析", sub: "架构与运行循环精读" },
  { id: "10", title: "实战", sub: "两个项目 + 速查表" },
];

const LANG_MAP = {
  python: "python", py: "python", bash: "bash", sh: "bash", shell: "bash",
  json: "json", text: "plaintext", txt: "plaintext", powershell: "powershell",
  ps1: "powershell", sql: "sql", yaml: "yaml", typescript: "typescript", ts: "typescript",
  javascript: "javascript", js: "javascript", html: "xml", xml: "xml",
};

function esc(s) {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
function stripTags(s) {
  return s.replace(/<[^>]+>/g, "");
}
function slugify(s) {
  return stripTags(s)
    .trim()
    .toLowerCase()
    .replace(/[\x60*_~]/g, "")
    .replace(/\s+/g, "-")
    .replace(/[^\w\u4e00-\u9fff-]/g, "")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "");
}

const usedIds = new Map();
function uniqueId(base, used) {
  let id = base || "section";
  if (!used.has(id)) { used.set(id, 1); return id; }
  let n = used.get(id) + 1;
  while (used.has(id + "-" + n)) n++;
  used.set(id, n);
  used.set(id + "-" + n, 1);
  return id + "-" + n;
}

const renderer = new marked.Renderer();
const tocPerChapter = [];
renderer.heading = function (text, level, raw) {
  const plain = stripTags(text);
  const id = uniqueId(slugify(plain), usedIds);
  if (level === 2 || level === 3) {
    tocPerChapter.push({ id, text: plain.replace(/[\x60]/g, ""), level });
  }
  return "<h" + level + ' id="' + id + '">' + text + "</h" + level + ">";
};
renderer.code = function (code, infostring) {
  const langRaw = (infostring || "").trim().split(/\s+/)[0].toLowerCase();
  const lang = LANG_MAP[langRaw] || "plaintext";
  let body;
  try {
    body = lang === "plaintext" ? esc(code) : hljs.highlight(code, { language: lang, ignoreIllegals: true }).value;
  } catch (e) {
    body = esc(code);
  }
  const label = langRaw || "text";
  return (
    '<div class="codeblock" data-lang="' + esc(label) + '">' +
    '<div class="codebar"><span class="lang">' + esc(label) + "</span>" +
    '<button class="copybtn" type="button" data-copy>复制</button></div>' +
    "<pre><code class=\"hljs language-" + lang + "\">" + body + "</code></pre></div>"
  );
};
renderer.table = function (header, body) {
  return '<div class="table-wrap"><table><thead>' + header + "</thead><tbody>" + body + "</tbody></table></div>";
};
renderer.link = function (href, title, text) {
  const t = title ? ' title="' + title + '"' : "";
  if (href && !/^https?:/i.test(href) && !href.startsWith("#")) {
    return '<span class="xlink">' + text + "</span>";
  }
  return '<a href="' + href + '" target="_blank" rel="noopener"' + t + ">" + text + "</a>";
};

marked.setOptions({ renderer, gfm: true, breaks: false });

function extractGoals(md) {
  const start = md.indexOf("## 学习目标");
  if (start < 0) return [];
  const rest = md.slice(start);
  const next = rest.indexOf("\n## ", 5);
  const block = next > 0 ? rest.slice(0, next) : rest;
  return block
    .split(/\r?\n/)
    .filter((l) => /^\s*-\s+/.test(l))
    .map((l) => l.replace(/^\s*-\s+/, "").replace(/[\x60]/g, "").trim())
    .filter(Boolean);
}

function plainText(md) {
  return md
    .replace(/[\x60]{3}[\s\S]*?[\x60]{3}/g, " ")
    .replace(/[\x60][^\x60]*[\x60]/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/^\s{0,3}#{1,6}\s+/gm, "")
    .replace(/^\s*>\s?/gm, "")
    .replace(/^\s*[-*+]\s+/gm, "")
    .replace(/^\s*\d+\.\s+/gm, "")
    .replace(/[|*_~]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

const chapters = [];
const dirs = fs.readdirSync(COURSE, { withFileTypes: true }).filter((d) => d.isDirectory() && /^\d\d-/.test(d.name));
for (const d of dirs) {
  const modId = d.name.slice(0, 2);
  const mod = MODULES.find((m) => m.id === modId);
  const files = fs.readdirSync(path.join(COURSE, d.name)).filter((f) => /^\d\d-.*\.md$/.test(f)).sort();
  for (const f of files) {
    const num = Number(f.slice(0, 2));
    const md = fs.readFileSync(path.join(COURSE, d.name, f), "utf8").replace(/^\uFEFF/, "");
    tocPerChapter.length = 0;
    usedIds.clear();
    let html = marked.parse(md);
    html = html.replace(/<h1[\s\S]*?<\/h1>/, "");
    html = html.replace(/<h2 id="[^"]*">学习目标<\/h2>[\s\S]*?(?=<h2)/, "");
    const titleMatch = md.match(/^#\s+(.+)$/m);
    const title = titleMatch ? titleMatch[1].trim() : f.replace(/\.md$/, "");
    const display = title.replace(/^第\d+章\s*/, "");
    chapters.push({
      num,
      moduleId: modId,
      moduleTitle: mod ? mod.title : d.name,
      title: display,
      fullTitle: title,
      file: d.name + "/" + f,
      html,
      toc: tocPerChapter.filter((t) => t.text !== "学习目标").slice(),
      goals: extractGoals(md),
      text: plainText(md),
      codeBlocks: (md.match(/[\x60]{3}/g) || []).length / 2,
      minutes: Math.max(6, Math.round(plainText(md).length / 420)),
    });
  }
}
chapters.sort((a, b) => a.num - b.num);

const quizzes = {};
const qdir = path.join(SITE, "quizzes");
if (fs.existsSync(qdir)) {
  for (const f of fs.readdirSync(qdir).filter((f) => f.endsWith(".json"))) {
    try {
      const obj = JSON.parse(fs.readFileSync(path.join(qdir, f), "utf8"));
      for (const [k, v] of Object.entries(obj)) {
        if (!Array.isArray(v)) continue;
        quizzes[k] = (quizzes[k] || []).concat(v);
      }
    } catch (e) {
      console.warn("quiz parse failed:", f, e.message);
    }
  }
}

const modules = MODULES.map((m) => ({ ...m, chapters: chapters.filter((c) => c.moduleId === m.id).map((c) => c.num) }));
const payload = {
  generatedAt: new Date().toISOString(),
  version: "0.25.0",
  modules,
  chapters,
  quizzes,
};

fs.mkdirSync(path.join(OUT, "assets"), { recursive: true });
fs.writeFileSync(path.join(OUT, "assets", "course-data.js"), "window.COURSE=" + JSON.stringify(payload) + ";", "utf8");

for (const f of ["index.html", "assets/app.css", "assets/app.js"]) {
  const src = path.join(SITE, f);
  if (fs.existsSync(src)) {
    const dst = path.join(OUT, f);
    fs.mkdirSync(path.dirname(dst), { recursive: true });
    fs.copyFileSync(src, dst);
  }
}
const hljsCss = path.join(SITE, "node_modules", "highlight.js", "styles", "github-dark-dimmed.min.css");
if (fs.existsSync(hljsCss)) fs.copyFileSync(hljsCss, path.join(OUT, "assets", "hljs.css"));

console.log("chapters:", chapters.length, "| quizzes:", Object.keys(quizzes).length, "| bytes:", fs.statSync(path.join(OUT, "assets", "course-data.js")).size);
